{
  "name": "ngx-smart-popover-demo",
  "version": "1.5.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ngx-smart-popover && npm run build:lib:scss && npm run build:lib:css",
    "build:lib:css": "sass ./projects/ngx-smart-popover/src/lib/popover-content.component.scss ./dist/ngx-smart-popover/css/popover-content.component.css",
    "build:lib:scss": "mkdir ./dist/ngx-smart-popover/scss/ && cp ./projects/ngx-smart-popover/src/lib/popover-content.component.scss ./dist/ngx-smart-popover/scss/popover-content.component.scss"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "16.2.12",
    "@angular/common": "16.2.12",
    "@angular/compiler": "16.2.12",
    "@angular/core": "16.2.12",
    "@angular/forms": "16.2.12",
    "@angular/platform-browser": "16.2.12",
    "@angular/platform-browser-dynamic": "16.2.12",
    "@angular/router": "16.2.12",
    "bootstrap": "4.3.1",
    "rxjs": "6.5.4",
    "zone.js": "~0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "16.2.16",
    "@angular/compiler-cli": "16.2.12",
    "@angular/language-service": "16.2.12",
    "@types/node": "8.9.5",
    "codelyzer": "^6.0.0",
    "ng-packagr": "^16.2.3",
    "sass": "^1.51.0",
    "scss-bundle": "3.1.2",
    "ts-node": "7.0.1",
    "tslib": "^2.0.0",
    "typescript": "^4.6.4"
  }
}

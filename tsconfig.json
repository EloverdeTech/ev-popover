{
    "compileOnSave": false,
    "compilerOptions": {
      "baseUrl": "./",
      "outDir": "./dist/out-tsc",
      "sourceMap": true,
      "declaration": false,
      "module": "es2015",
      "moduleResolution": "node",
      "experimentalDecorators": true,
      "importHelpers": true,
      "target": "ES2022",
      "typeRoots": [
        "node_modules/@types"
      ],
      "lib": [
        "es2018",
        "dom"
      ],
      "paths": {
        "ev-popover": [
          "dist/ev-popover"
        ],
        "ev-popover/*": [
          "dist/ev-popover/*"
        ]
      },
      "useDefineForClassFields": false
    }
}